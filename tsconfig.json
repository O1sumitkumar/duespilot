{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": ["server/**/*", "shared/**/*", "scripts/**/*", "eval/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "client"]
}